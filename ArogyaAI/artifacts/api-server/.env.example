PORT=8080

# Same Postgres connection string as lib/db/.env
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any long random string — used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Free key from https://aistudio.google.com/apikey — powers the AI chat/triage feature.
# The chat feature falls back to a canned demo response if this is left blank.
GEMINI_API_KEY=

# The frontend's origin, for CORS. Match this to wherever the frontend runs.
CORS_ORIGIN=http://localhost:5000
